generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int       @id @default(autoincrement())
  nombre       String
  email        String    @unique
  telefono     String
  password     String
  verificado   Boolean   @default(false)
  activo       Boolean   @default(true)
  rol          String    @default("usuario")
  token        String?
  codigoExpira DateTime?
  createdAt    DateTime  @default(now())

  emprendedora Emprendedora?
  auditorias   Auditoria[]
  pedidos      Pedido[]
  pagos Pago[]
  pagoLogs PagoLog[]
  destacadoLogs DestacadoLog[]
  productosCreados  Producto[] @relation("ProductoCreador")


  alianzasCreadas      Alianza[]             @relation("AlianzaCreador")
  alianzasParticipante AlianzaParticipante[]
  cupones              Cupon[]
  comentarios          Comentario[]
  notificaciones Notificacion[]
  favoritos Favorito[]
  movimientos MovimientoInventario[]
  alianzaLogs AlianzaLog[]
  cuponUsos CuponUso[]
  foto_documento       String?
  carrito              Carrito?
}

model VerificacionPendiente {
  email          String   @id
  nombre         String
  telefono       String
  password       String
  codigo         String
  expiracion     DateTime
  rol            String   @default("usuario")
  foto_documento String?
}

model Emprendedora {
  id_emprendedora Int     @id @default(autoincrement())
  id_usuario      Int     @unique
  datos_bancarios String?
  estado          Boolean @default(true)

  nequi_numero      String?
  bancolombia_numero String?
  liquidaciones Liquidacion[]
  bancolombia_tipo  String?  // "ahorros" | "corriente"
  titular_cuenta    String?
  acepta_contraentrega Boolean @default(false)

  usuario   User      @relation(fields: [id_usuario], references: [id])
  secciones Seccion[]

  @@map("emprendedoras")
}

model Seccion {
  id_seccion      Int      @id @default(autoincrement())
  id_emprendedora Int
  nombre_seccion  String
  fecha_creacion  DateTime @default(now())
  id_alianza      Int?

  emprendedora Emprendedora @relation(fields: [id_emprendedora], references: [id_emprendedora])
  productos    Producto[]
  pedidos      Pedido[]
  alianza      Alianza?     @relation(fields: [id_alianza], references: [id_alianza])

  @@map("secciones")
}

model Producto {
  id_producto               Int      @id @default(autoincrement())
  id_seccion                Int
  id_creador                Int?
  nombre_producto           String
  descripcion               String?
  precio                    Decimal  @db.Decimal(15, 2)
  categoria                 String?
  estado_producto           String   @default("activo")
  duracion                  String?
  tipo                      String   @default("producto") // "producto" o "servicio"
  imagen                    String?
  tamano_imagen             Int?
  stock_minimo              Int      @default(0)
  ultima_modificacion_stock DateTime @default(now()) @updatedAt
  solicitud_pendiente Boolean   @default(false)   // emprendedora solicitó, esperando decisión
  categoria_destacado String?                     // "nuevos" | "mas_vendidos" | "en_oferta" | null (manual)
  fecha_solicitud     DateTime?                   
  fecha_decision      DateTime? 

  seccion     Seccion         @relation(fields: [id_seccion], references: [id_seccion])
  creador    User?       @relation("ProductoCreador", fields: [id_creador], references: [id])
  inventario Inventario?
  detalles    DetallePedido[]
  comentarios Comentario[]
  favoritos Favorito[]
  movimientos MovimientoInventario[]

  destacado    Boolean       @default(false)
  visible      Boolean       @default(true)
  carritoItems CarritoItem[]

  reglas_descuento ReglaDescuento[]
  destacadoLogs    DestacadoLog[]     // relación inversa
  destacadoEventos DestacadoEvento[]

  @@map("producto")
}

model Inventario {
  id_inventario Int @id @default(autoincrement())
  id_producto   Int @unique
  cantidad      Int
  stock_minimo  Int
  stock_maximo  Int

  producto Producto @relation(fields: [id_producto], references: [id_producto], onDelete: Cascade)

  @@map("inventario")
}

model Auditoria {
  id_auditoria      Int      @id @default(autoincrement())
  id_usuario_accion Int
  id_registro       Int
  tabla_afectada    String   @db.VarChar(50)
  accion            String   @db.VarChar(50)
  fecha             DateTime
  detalles          String?  @db.VarChar(500)

  usuario User @relation(fields: [id_usuario_accion], references: [id])

  @@map("auditoria")
}
model Pedido {
  id_pedido   Int      @id @default(autoincrement())
  id_cliente  Int
  id_seccion  Int
  id_pago     Int?           // ← nuevo
  estado      String   @default("pendiente_pago")
  total       Decimal  @db.Decimal(10, 3)
  fecha       DateTime @default(now())
  nota        String?
  id_cupon        Int?
  descuento_cupon Decimal? @db.Decimal(10, 3)

  cuponUso CuponUso? 

  liquidacion Liquidacion?

  factura Factura?

  cliente     User            @relation(fields: [id_cliente], references: [id])
  seccion     Seccion         @relation(fields: [id_seccion], references: [id_seccion])
  pago        Pago?           @relation(fields: [id_pago], references: [id_pago])  // ← nuevo
  detalles    DetallePedido[]
  comentarios Comentario[]
  

  @@map("pedidos")
}

model DetallePedido {
  id_detalle  Int     @id @default(autoincrement())
  id_pedido   Int
  id_producto Int
  cantidad    Int
  precio_unit Decimal @db.Decimal(10, 3)

  pedido   Pedido   @relation(fields: [id_pedido], references: [id_pedido])
  producto Producto @relation(fields: [id_producto], references: [id_producto])

  @@map("detalle_pedidos")
}

model Alianza {
  id_alianza   Int       @id @default(autoincrement())
  nombre       String
  descripcion  String?
  estado       String    @default("pendiente")
  fecha_inicio DateTime  @default(now())
  fecha_fin    DateTime?
  creada_por   Int

  creador       User                  @relation("AlianzaCreador", fields: [creada_por], references: [id])
  participantes AlianzaParticipante[]
  secciones     Seccion[]
  logs    AlianzaLog[]     
  eventos AlianzaEvento[] 

  @@map("alianzas")
}

model AlianzaParticipante {
  id          Int      @id @default(autoincrement())
  id_alianza  Int
  id_usuario  Int
  autorizado  Boolean  @default(false)
  fecha_union DateTime @default(now())

  alianza Alianza @relation(fields: [id_alianza], references: [id_alianza])
  usuario User    @relation(fields: [id_usuario], references: [id])

  @@unique([id_alianza, id_usuario])
  @@map("alianza_participantes")
}

model Cupon {
  id_cupon     Int       @id @default(autoincrement())
  id_usuario   Int
  codigo       String    @unique
  tipo         String // "porcentaje" o "valor_fijo"
  valor        Decimal   @db.Decimal(10, 3)
  descripcion  String?
  activo       Boolean   @default(true)
  fecha_inicio DateTime  @default(now())
  fecha_fin    DateTime?
  limite_usos  Int?
  usos         Int       @default(0)

  usuario User @relation(fields: [id_usuario], references: [id])
  usosLog CuponUso[]

  @@map("cupones")
}
model CuponUso {
  id_uso          Int      @id @default(autoincrement())
  id_cupon        Int
  id_cliente      Int
  id_pedido       Int      @unique
  monto_descuento Decimal  @db.Decimal(10, 3)
  fecha           DateTime @default(now())

  cupon   Cupon  @relation(fields: [id_cupon], references: [id_cupon])
  cliente User   @relation(fields: [id_cliente], references: [id])
  pedido  Pedido @relation(fields: [id_pedido], references: [id_pedido])

  @@map("cupon_usos")
}

model Comentario {
  id_comentario Int      @id @default(autoincrement())
  id_producto   Int
  id_usuario    Int
  id_pedido     Int
  calificacion  Int // 1-5
  texto         String
  activo        Boolean  @default(true)
  fecha         DateTime @default(now())

  producto Producto @relation(fields: [id_producto], references: [id_producto])
  usuario  User     @relation(fields: [id_usuario], references: [id])
  pedido   Pedido   @relation(fields: [id_pedido], references: [id_pedido])

  @@map("comentarios")
}

model Carrito {
  id_carrito Int      @id @default(autoincrement())
  id_usuario Int      @unique
  fecha_act  DateTime @default(now()) @updatedAt

  usuario User          @relation(fields: [id_usuario], references: [id])
  items   CarritoItem[]

  @@map("carritos")
}

model CarritoItem {
  id_item     Int @id @default(autoincrement())
  id_carrito  Int
  id_producto Int
  cantidad    Int @default(1)

  carrito  Carrito  @relation(fields: [id_carrito], references: [id_carrito], onDelete: Cascade)
  producto Producto @relation(fields: [id_producto], references: [id_producto], onDelete: Cascade)

  @@unique([id_carrito, id_producto])
  @@map("carrito_items")
}

model Pago {
  id_pago      Int       @id @default(autoincrement())
  id_cliente   Int
  monto_total  Decimal   @db.Decimal(10, 3)
  metodo       String
  estado       String    @default("pendiente") // pendiente | aprobado | rechazado
  comprobante  String?
  fecha        DateTime  @default(now())
  fecha_verif  DateTime?
  nota_rechazo String?

  cliente User     @relation(fields: [id_cliente], references: [id])
  pedidos Pedido[]
  logs PagoLog[]

  @@map("pagos")
}

model Notificacion {
  id_notificacion Int      @id @default(autoincrement())
  id_usuario      Int
  tipo            String   // "pedido", "cupon", "solicitud"
  titulo          String
  mensaje         String
  leida           Boolean  @default(false)
  fecha           DateTime @default(now())
  url             String?  // ruta a donde navegar al hacer click

  usuario User @relation(fields: [id_usuario], references: [id])

  @@map("notificaciones")
}

model Favorito {
  id_favorito Int      @id @default(autoincrement())
  id_usuario  Int
  id_producto Int
  fecha       DateTime @default(now())

  usuario  User     @relation(fields: [id_usuario], references: [id])
  producto Producto @relation(fields: [id_producto], references: [id_producto])

  @@unique([id_usuario, id_producto])
  @@map("favoritos")
}

model ReglaDescuento {
  id_regla      Int      @id @default(autoincrement())
  id_producto   Int
  nombre        String
  tipo          String   // "porcentaje" | "valor_fijo"
  valor         Decimal  @db.Decimal(10, 2)
  condicion     String   // "stock_bajo" | "stock_menor_a" | "siempre"
  stock_limite  Int?     // usado cuando condicion = "stock_menor_a"
  activa        Boolean  @default(true)
  prioridad     Int      @default(1)
  fecha_inicio  DateTime @default(now())
  fecha_fin     DateTime?

  producto Producto @relation(fields: [id_producto], references: [id_producto])

  @@map("reglas_descuento")
}

model MovimientoInventario {
  id_movimiento  Int      @id @default(autoincrement())
  id_producto    Int
  tipo           String   // "entrada" | "salida" | "ajuste"
  cantidad_antes Int
  cantidad_nueva Int
  motivo         String?
  fecha          DateTime @default(now())
  id_usuario     Int

  producto Producto @relation(fields: [id_producto], references: [id_producto])
  usuario  User     @relation(fields: [id_usuario], references: [id])

  @@map("movimientos_inventario")
}

model ConfiguracionPago {
  id                    Int      @id @default(autoincrement())
  nequi_numero          String?
  bancolombia_numero    String?
  bancolombia_tipo      String?
  titular_cuenta        String?
  acepta_contraentrega  Boolean  @default(true)
  actualizado           DateTime @updatedAt

  @@map("configuracion_pago")
}

model PagoLog {
  id_log     Int      @id @default(autoincrement())
  id_pago    Int?
  id_usuario Int?
  evento     String   // "creado" | "comprobante_subido" | "error_subida" | "aprobado" | "rechazado" | "error_verificacion"
  detalle    String?
  fecha      DateTime @default(now())

  pago    Pago? @relation(fields: [id_pago], references: [id_pago])
  usuario User? @relation(fields: [id_usuario], references: [id])

  @@map("pago_logs")
}

model Liquidacion {
  id_liquidacion  Int      @id @default(autoincrement())
  id_pedido       Int      @unique
  id_emprendedora Int
  monto           Decimal  @db.Decimal(10, 3)
  estado          String   @default("pendiente") // pendiente | pagado
  fecha_generada  DateTime @default(now())
  fecha_pagado    DateTime?
  nota            String?

  pedido       Pedido       @relation(fields: [id_pedido], references: [id_pedido])
  emprendedora Emprendedora @relation(fields: [id_emprendedora], references: [id_emprendedora])

  @@map("liquidaciones")
}

model Factura {
  id_factura        Int      @id @default(autoincrement())
  id_pedido         Int      @unique
  numero            String   @unique
  url_pdf           String
  fecha_emision     DateTime @default(now())
  nota_regeneracion String?
  activa            Boolean  @default(true)

  pedido Pedido @relation(fields: [id_pedido], references: [id_pedido])

  @@map("facturas")
}

model ConfiguracionDestacados {
  id               Int      @id @default(autoincrement())
  dias_nuevo       Int      @default(7)   // RN-065: umbral configurable por admin
  top_mas_vendidos Int      @default(10)
  actualizado      DateTime @updatedAt

  @@map("configuracion_destacados")
}

model DestacadoLog {
  id_log      Int      @id @default(autoincrement())
  id_producto Int
  id_usuario  Int?
  evento      String   // "solicitado" | "aprobado" | "rechazado" | "desactivado"
  detalle     String?
  fecha       DateTime @default(now())

  producto Producto @relation(fields: [id_producto], references: [id_producto])
  usuario  User?    @relation(fields: [id_usuario], references: [id])

  @@map("destacado_logs")
}

model DestacadoEvento {
  id_evento   Int      @id @default(autoincrement())
  id_producto Int
  tipo        String   // "visita" | "clic"
  fecha       DateTime @default(now())

  producto Producto @relation(fields: [id_producto], references: [id_producto])

  @@map("destacado_eventos")
}

model AlianzaLog {
  id_log      Int      @id @default(autoincrement())
  id_alianza  Int
  id_usuario  Int?
  evento      String   // "creada" | "autorizada" | "pendiente_aprobacion" | "aprobada" | "rechazada" | "desactivada" | "finalizada" | "vencida"
  detalle     String?
  fecha       DateTime @default(now())

  alianza Alianza @relation(fields: [id_alianza], references: [id_alianza])
  usuario User?   @relation(fields: [id_usuario], references: [id])

  @@map("alianza_logs")
}

model AlianzaEvento {
  id_evento  Int      @id @default(autoincrement())
  id_alianza Int
  tipo       String   // "visita" | "clic"
  fecha      DateTime @default(now())

  alianza Alianza @relation(fields: [id_alianza], references: [id_alianza])

  @@map("alianza_eventos")
}