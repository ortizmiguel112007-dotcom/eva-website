{
  "name": "eva-project",
  "private": true,
  "version": "1.1.0",
  "scripts": {
    "install:all": "npm install",
    "db:generate": "npm run db:generate --workspace=backend",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "dev:front": "npm run dev --workspace=frontend",
    "dev:back": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=frontend",
    "dev": "concurrently \"npm run dev:back\" \"npm run dev:front\""
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "devDependencies": {
    "@types/pg": "^8.18.0",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14"
  },
  "dependencies": {
    "pdfkit": "^0.19.1",
    "pg": "^8.20.0"
  }
}
