{
  "name": "eva-project",
  "private": true,
  "version": "1.1.0",
  "scripts": {
    "install:all": "npm install",
    "postinstall": "npm run db:generate -w backend",
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "dev:front": "npm run dev -w frontend",
    "dev:back": "npm run dev -w backend",
    "build": "prisma generate && next build",
    "dev": "concurrently \"npm run dev:back\" \"npm run dev:front\""
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "devDependencies": {
    "@types/pg": "^8.18.0",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14",
    "prisma": "^7.4.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "pdfkit": "^0.19.1",
    "pg": "^8.20.0"
  }
}
